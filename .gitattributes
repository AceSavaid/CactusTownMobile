# Normalize line endings; Godot text resources are LF
* text=auto eol=lf

*.gd    text
*.tscn  text
*.tres  text
*.godot text
*.import text
*.cfg   text
*.svg   text
*.md    text
*.cs    text

*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ogg   binary
*.wav   binary
*.mp3   binary
*.ttf   binary
*.otf   binary
