# Godot 4+ engine cache / import data
.godot/
.import/

# Mono / .NET build output (anchored to project root — do not match asset dirs)
.mono/
data_*/
mono_crash.*.json
*.csproj.user
/bin/
/obj/

# Exported builds
/build/
/exports/

# Godot Android gradle build template (regenerate via Project > Install Android Build Template)
/android/

# Keystores — never commit
*.keystore
*.jks

# Export presets can contain keystore paths/passwords — keep local
export_presets.cfg
export.cfg

# Auto-generated translations
*.translation

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*~

# Godot csproj rewrite backups
*.csproj.old

# Windows/MSYS crash dumps
*.stackdump
